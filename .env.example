# Get your v0 API key here: https://v0.dev/chat/settings/keys
V0_API_KEY="your_v0_api_key"

# Optional: for rate limiting
KV_REST_API_URL=your_upstash_redis_rest_url
KV_REST_API_TOKEN=your_upstash_redis_rest_token

# Cloudflare R2 image origin (Worker or custom domain). Git copies stay in /public as backup.
# Example after `npm run images:bucket`, `npm run images:sync`, `npm run images:worker`:
# NEXT_PUBLIC_IMAGE_CDN=https://images.vegas55plushomes.com
NEXT_PUBLIC_IMAGE_CDN=

# Wrangler (local/CI upload only — do not commit secrets)
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# R2_BUCKET=vegas55plus-images
